# Copie para .env e preencha. O .env nunca vai para o git.

# Obrigatórias. ATENÇÃO: valor com # precisa de aspas ("…"); sem aspas, o
# dotenv corta tudo a partir do # (a senha viraria só o pedaço antes dele).
JWT_SECRET=gere-com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_INITIAL_PASSWORD="senha-forte-do-admin-12-ou-mais"

# Endereço público (usado nos links dos e-mails). Em dev, o Vite.
APP_BASE_URL=http://localhost:5173

# --- IA da avaliação -------------------------------------------------------
# Sem a chave, o app roda em MODO DEMONSTRAÇÃO: a avaliação sai na hora, com
# notas e textos fictícios, para navegar o fluxo inteiro sem custo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# batch  → Batch API (50% mais barato, até 24h). É o modo de produção.
# direto → chamadas normais em paralelo (minutos). Útil para testar com a chave.
AVALIACAO_MODO=batch
# Esforço de raciocínio. Vazio ("") omite o parâmetro.
AVALIADOR_EFFORT=high
SINTETIZADOR_EFFORT=medium
# De quanto em quanto tempo o varredor submete e coleta lotes (ms).
AVALIACAO_INTERVALO_MS=120000
# Máximo de submissões num mesmo lote.
BATCH_MAX_SUBMISSOES=20

# --- E-mail (Microsoft Graph / Entra) — configurar depois ---------------------
# Sem estas variáveis, os e-mails NÃO saem: ficam registrados em
# Admin → E-mails com o estado "não configurado", para conferir o conteúdo.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Credencial: certificado (preferido) OU segredo.
GRAPH_CERT_THUMBPRINT=
GRAPH_CERT_KEY_FILE=
GRAPH_CERT_PRIVATE_KEY=
GRAPH_CLIENT_SECRET=
MAIL_FROM=
MAIL_FROM_NAME=Submissões Allos

# Produção: volume persistente (o banco SQLite mora aqui)
# DATA_DIR=/data
