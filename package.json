{
  "name": "submissoes-allos",
  "version": "0.1.0",
  "private": true,
  "description": "Submissões Allos · editais, submissão, avaliação por IA e revisão de textos para a revista",
  "scripts": {
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "client": "cd client && npx vite --host",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install --include=dev && npx vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "postinstall": "cd client && npm install --include=dev",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.1",
    "express": "4.22.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "openai": "6.38.0"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "supertest": "7.2.2",
    "vitest": "2.1.9"
  }
}
